# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Corpus: source documents are pinned by manifest, never committed.
data/corpus/raw/*
!data/corpus/raw/.gitkeep
data/corpus/processed/
data/index/

# The gate verdict is per-invocation output, not a report: it names the run id
# and carries freshly measured latencies, so committing it would make every
# `make eval` a diff. CI uploads it as an artifact and comments it on the PR.
reports/gate.md
reports/gate.json

# Run artifacts are immutable. The ablation sweep behind reports/pareto.md is
# committed (1.3 MB) so the report is verifiable from the repository; ad-hoc
# runs are not, so `make eval` does not dirty the tree.
runs/scratch/

# Local caches
.cache/
*.sqlite
*.sqlite-journal

# Secrets
.env
